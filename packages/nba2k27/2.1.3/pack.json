  "controllerTrainer": {
    "shots": [
      {
        "id": "standing-still",
        "label": "Standing Still",
        "instructions": "Stand still in your practice area and record one complete shot with the selected shot input."
      },
      {
        "id": "off-dribble",
        "label": "Off-Dribble",
        "instructions": "Dribble manually into the shot and record the selected shot input. Movement and other controls remain live when you tap the assigned input to replay the shot."
      },
      {
        "id": "fade-away",
        "label": "Fade-Away",
        "instructions": "Move into your fade-away manually and record the selected shot input. Use the same movement and animation when you practice its one-tap shot playback."
      }
    ],
    "timingFeedback": [
      {
        "id": "none",
        "label": "No timing feedback",
        "adjustmentMs": 0
      },
      {
        "id": "early",
