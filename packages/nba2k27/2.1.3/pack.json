        "adjustmentMs": 8
      },
      {
        "id": "excellent",
        "label": "Excellent",
        "adjustmentMs": 0
      },
      {
        "id": "slightly-late",
        "label": "Slightly Late",
        "adjustmentMs": -8
      },
      {
        "id": "late",
        "label": "Late",
        "adjustmentMs": -16
      }
    ],
    "tempoFeedback": [
      {
        "id": "none",
